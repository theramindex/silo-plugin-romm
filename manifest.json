  "metadata": {
    "display_name": "RomM for Silo",
    "summary": "Your RomM collection, with browser play and personal saves."
  },
  "presentation": {
    "display_name": "RomM for Silo",
    "summary": "Your RomM collection, with browser play and personal saves.",
    "description_markdown": "Browse platforms, collections and games from RomM. Connect each Silo profile to its own RomM account, then play NES, SNES, GB, GBC and GBA games using locally bundled EmulatorJS. Requires the Ramindex Silo loopback relay. No ROMs or BIOS are included.",
    "setup_markdown": "Set the RomM server URL in plugin settings, reachable from Silo and your browser. Open Games, choose Sign in to RomM, and approve Silo Games using your normal RomM or OIDC login. Token and pairing-code entry remain available for older servers. Keep the plugin data directory on persistent storage.",
    "homepage_url": "https://github.com/theramindex/silo-plugin-romm",
    "source_url": "https://github.com/theramindex/silo-plugin-romm",
    "support_url": "https://github.com/theramindex/silo-plugin-romm/issues",
    "changelog_url": "https://github.com/theramindex/silo-plugin-romm/releases",
    "publisher_name": "Ramindex",
    "publisher_url": "https://github.com/theramindex",
    "license_spdx": "GPL-3.0-only"
  },
  "category": "Games"
}
