    {
      "key": "connection",
      "title": "RomM server",
      "description": "Set the address of your RomM server.",
      "json_schema": "{\"type\": \"object\", \"properties\": {\"url\": {\"type\": \"string\", \"title\": \"RomM server address\", \"description\": \"HTTP or HTTPS base URL reachable from Silo. Each viewer connects their own RomM account in Games.\"}}, \"additionalProperties\": false}",
